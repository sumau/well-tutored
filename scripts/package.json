{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "smoke": "tsx ./src/smoke-check.ts",
    "smoke:published": "tsx ./src/smoke-check.ts --published",
    "smoke:published:lifecycle": "tsx ./src/publish-smoke.ts",
    "smoke:enquiry": "tsx ./src/enquiry-browser-smoke.ts",
    "smoke:enquiry:published": "tsx ./src/enquiry-browser-smoke.ts --published",
    "test:smoke": "tsx --test ./src/smoke-check.test.ts ./src/publish-smoke.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  }
}
