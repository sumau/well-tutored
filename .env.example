# Copy to .env for local Docker runs. docker-compose.yml loads it if present.

# REQUIRED locally. The API mounts Clerk middleware under /api, so every request
# there — including public ones — fails with 500 when this is unset. The
# Deployment carries it as a Fly secret.
#
# A syntactically valid placeholder is enough to browse the public site
# (directory, tutor profiles, resources, enquiry flow). Use a real Clerk dev
# key (sk_test_...) if you need to sign in to the private /workspace area.
CLERK_SECRET_KEY=sk_test_00000000000000000000000000000000

# Needed only for the private /workspace area, alongside a real secret key.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
